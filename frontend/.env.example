# ===== 前端环境变量（Vite，必须以 VITE_ 开头才会注入到浏览器）=====
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不会提交到仓库。

# Supabase 项目地址（格式：https://<project-ref>.supabase.co）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key（公开安全，可放前端；真正的百度密钥只在 Edge Function 环境变量里）
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GitHub Pages 基路径（部署到 https://<user>.github.io/<repo>/ 时改为 /<repo>/，本地留空）
VITE_BASE_URL=/yingfubao/
