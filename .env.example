# 应付宝 环境变量示例（复制为 .env 并填写）
# 复制本文件为 backend/.env 后修改

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=yingfubao-secret-key-change-in-production

# ===== OCR 引擎（可选）=====
# 方式一：腾讯云 OCR（增值税发票识别，精度最高，推荐生产使用）
# 在腾讯云控制台 -> 访问管理 -> API密钥管理 获取
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 方式二：本地 Tesseract（服务器需安装 tesseract 并含中文包 chi_sim）
# 仅当未配置腾讯云密钥时自动启用；未安装则系统仍可运行（上传后转人工补录）
# 无需额外变量，检测到 tesseract 命令即启用
